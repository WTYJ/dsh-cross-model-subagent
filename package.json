{
  "name": "@wtyj/dsh-cross-model-subagent",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/WTYJ/dsh-cross-model-subagent.git" },
  "homepage": "https://github.com/WTYJ/dsh-cross-model-subagent",
  "license": "MIT",
  "description": "Set global or per-session models for native subagents and see confirmed agent models when new Agent Teams members join. Check for and install updates from the settings page.",
  "previousNames": [
    "@local/dsh-cross-model-subagent"
  ],
  "exports": {
    ".": "./index.js",
    "./updates": "./updating-entry.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "installed.js",
    "routing.js",
    "status-web.js",
    "updating.js",
    "git-update.js",
    "updating-host.js",
    "updating-entry.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "LICENSE",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
